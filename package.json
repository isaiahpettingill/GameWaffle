    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "blockly": "13.5.0",
    "cbor-x": "1.6.9",
    "fflate": "0.8.3",
    "pngjs": "7.0.0",
    "qoa-format": "1.0.1",
    "svelte": "5.59.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "vite": "8.3.8",
