{
  "name": "gamewaffle",
  "license": "0BSD",
  "version": "0.2.0",
  "description": "Sprite game studio and Rust cartridge runtime",
  "scripts": {
    "check": "cargo test --manifest-path runtime/Cargo.toml --locked && npm run build && node packaging/check-game.mjs && node packaging/check-scripts.mjs && node packaging/check-script-surfaces.mjs && node packaging/check-clones.mjs && node packaging/check-sensing.mjs && node packaging/check-resource-tables.mjs && node packaging/check-shaders.mjs && node packaging/check-desktop.mjs",
    "check:editor": "node packaging/check-editor.cjs",
    "build:native": "node src/build.mjs --native",
    "build:player": "node src/build.mjs --player-only",
    "prebuild": "node src/check-dependencies.mjs",
    "build": "node src/compiler.mjs && node src/build.mjs --check-demo",
    "start": "node src/start-studio.mjs",
    "demo": "node src/demo.mjs",
    "cart": "node src/compiler.mjs",
    "export:web": "node src/web-export.mjs",
    "studio:browser": "node src/start-studio.mjs --browser"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "1.78.0",
    "@webgpu/glslang": "0.0.15",
    "@xyflow/svelte": "2.0.3",
    "blockly": "13.5.0",
    "cbor-x": "1.6.9",
    "fflate": "0.8.3",
    "pngjs": "7.0.0",
    "qoa-format": "1.0.1",
    "svelte": "5.59.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
